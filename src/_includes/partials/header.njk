{#- Orijinal sitedeki menü HTML'i bir CMS tarafından üretiliyor; JS id/class'lara bağlı olduğu için yapı birebir korunuyor. -#}
{%- macro menuList(mobile) -%}
<ul class='flex {{ "flex-col gap-3 w-full" if mobile else "flex-row " }}' data-value='' data-class=''>
{%- for menu in nav.menus -%}
<li class='lists w-fit tab-click {{ "w-full px-0 " if mobile }}' id='{{ menu.id }}' data-section='{{ menu.section }}'><a class= "flex flex-row dropdown-toggle {{ "flex justify-between px-7 " if mobile else " menu-link items-center " }}" href="javascript:void(0)" target="">{{ menu.label }}</a><ul class='dropdown-menu hidden selected-div double-tap{{ " shadow-none px-6" if mobile }}' data-value='{{ menu.id }}' data-class=''>
{%- for item in menu.items -%}
<li class=' '  ><a class= "flex flex-row  " href="{{ item.href }}" target="">{{ item.label }}</a><ul class='dropdown-menu hidden selected-div double-tap{{ " shadow-none px-6" if mobile }}' data-value='{{ item.id }}' data-class=''></ul></li>
{%- endfor -%}
</ul></li>
{%- endfor -%}
</ul>
{%- endmacro -%}

{%- macro loginMenu(clientHref) -%}
<li>
    <a href="{{ clientHref }}" class="flex items-center gap-2 px-4 py-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="20" viewBox="0 0 17 22" fill="none">
            <path
                d="M12.249 4.75C12.249 5.74456 11.8539 6.69839 11.1507 7.40165C10.4474 8.10491 9.49356 8.5 8.499 8.5C7.50444 8.5 6.55061 8.10491 5.84735 7.40165C5.14409 6.69839 4.749 5.74456 4.749 4.75C4.749 3.75544 5.14409 2.80161 5.84735 2.09835C6.55061 1.39509 7.50444 1 8.499 1C9.49356 1 10.4474 1.39509 11.1507 2.09835C11.8539 2.80161 12.249 3.75544 12.249 4.75V4.75ZM1 18.868C1.03213 16.9004 1.83634 15.0242 3.23918 13.644C4.64202 12.2639 6.53109 11.4905 8.499 11.4905C10.4669 11.4905 12.356 12.2639 13.7588 13.644C15.1617 15.0242 15.9659 16.9004 15.998 18.868C13.6454 19.9468 11.0871 20.5035 8.499 20.5C5.823 20.5 3.283 19.916 1 18.868Z"
                stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Müşteri
    </a>
</li>
<li>
    <a href="/ib" class="flex items-center gap-2 px-4 py-2 ">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 22 22" fill="none">
            <path d="M1 18.9309L21 1L11.3833 21L9.01453 16.629L1 18.9309Z" stroke="white" stroke-width="1.5"
                stroke-linejoin="round" />
        </svg>
        Ortak
    </a>
</li>
{%- endmacro -%}

{%- macro langDropdown(btnType) -%}
<div class="relative inline-block w-fit ">
    <button {% if btnType %}type="{{ btnType }}" {% endif %}class="dropdown-lang-btn flex items-center text-black text-[16px] font-[400] uppercase  px-2 justify-between bg-white dropdown-toggle">
        <span id="selected-lang" class="flex items-center gap-2">
            <div class="w-[16px] h-auto ">
                <img src="/build/assets/lang_icon-725a8d10.png" width="1.6" height="1.6"
                    class="w-full object-contain aspect-auto inline-block " fetchpriority="high" alt="">
            </div>
            <div class="leading-none mx-1">
                TR
            </div>
        </span>
    </button>
    <ul class="dropdown-language absolute mt-1 w-20 rounded-[8px] bg-[#1A1A2FBF] text-white shadow-lg hidden z-50">
        <li class="flex items-center gap-1 px-2 py-1 cursor-pointer hover:bg-gray-200 hover:rounded-[8px]" data-lang="tr">
            <div class="w-[16px] h-auto "><img src="/build/assets/tr-be7d115b.svg" width="1.6" height="1.6"
                    class="w-full object-contain aspect-auto inline-block mx-0 rounded-full" fetchpriority="high" alt="">
            </div>
            <span class="leading-none mx-1"> TR</span>
        </li>
    </ul>
</div>
{%- endmacro -%}

<header
    class=" fixed top-[var(--app-promo-offset)] md:top-0  flex lg:justify-center justify-between w-full bg-white h-[76px] z-[999]">
    <div class="group relative container w-full  hidden md:block">

        <!-- büyük ekranlar -->
        <nav class="w-full h-full mx-auto relative">
            <div class="flex flex-row gap-5 justify-between  items-center md:gap-1">
                <div class="p-[8px]">
                    <a href="/" class="trust-logo-new-home">
                        <img class="w-full h-full" src="/build/assets/logo-tc-a2598083.png" alt="logo" loading="eager" />
                    </a>
                </div>
                <div class="header-area">
                    {{ menuList(false) }}
                </div>
                <div class="log-lg-container flex flex-row items-center gap-2 justify-evenly">
                    <div class="flex flex-row items-center gap-2">
                        <div class="login-dropdown relative inline-block text-left">
                            <button id="loginButton" class="loginButton flex items-center px-5 py-2">
                                Giriş
                            </button>
                            <ul id="loginDropdown"
                                class="loginDropdown absolute mt-2 w-40 rounded-[22px] bg-[#000] text-white shadow-lg hidden z-50">
                                {{ loginMenu(site.links.clientLogin) }}
                            </ul>
                        </div>
                        <div>
                            {{ langDropdown("button") }}
                        </div>
                    </div>
                </div>
            </div>
        </nav>

    </div>
    <!-- küçük ekranlar -->
    <nav class="w-full md:hidden block small_screen">
        <div class="flex flex-row justify-between h-full items-center m-auto sm:px-0 px-4">
            <a href="/" class="trust-logo-new-home">
                <img class="w-full h-full" src="/build/assets/logo-tc-3x-a7ad4f20.png" alt="logo" loading="eager" />
            </a>
            <div class="flex gap-5 items-center">
                <div>
                    {{ langDropdown() }}
                </div>
                <div>
                    <div class="login-dropdown relative inline-block text-left">
                        <button
                            class="loginButton bg-[var(--primary-color)] rounded-[33px] font-[500] text-[12px] md:text-[18px] py-2 px-3 text-[var(--btn-text)]"
                            type="submit">Giriş </button>

                        <ul id="loginDropdown"
                            class="loginDropdown absolute right-0 mt-2 w-40 rounded-[22px] bg-[#000] text-white shadow-lg hidden z-50">
                            {{ loginMenu(site.links.clientLogin) }}
                        </ul>
                    </div>
                </div>
                <span class="material-symbols-outlined text-black cursor-pointer" id="mobileMenuButtons">
                    <svg xmlns="http://www.w3.org/2000/svg" id="icon-open" class="transition-all duration-500"
                        width="21" height="18" viewBox="0 0 21 18" fill="none">
                        <path id="line-top" d="M1 1H20" stroke="black" stroke-width="2" stroke-linecap="round"
                            class="origin-top-left transition-transform duration-500" />
                        <path id="line-mid" d="M1 9H20" stroke="black" stroke-width="2" stroke-linecap="round"
                            class="transition-opacity duration-300" />
                        <path id="line-bot" d="M1 17H20" stroke="black" stroke-width="2" stroke-linecap="round"
                            class="origin-bottom-left transition-transform duration-500" />
                    </svg>

                    <svg id="icon-close" class="hidden transition-all duration-500"
                        xmlns="http://www.w3.org/2000/svg" width="19" height="16" viewBox="0 0 19 16" fill="none">
                        <path d="M3.00049 1L16.4355 14.435" stroke="black" stroke-width="2" stroke-linecap="round" />
                        <path d="M3 14.4346L16.435 0.999542" stroke="black" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </span>
            </div>
        </div>
        <div class="hidden transition-all duration-300 ease-in-out bg-white absolute left-0 w-screen z-10" id="mainMenu">
            <div class="header-area flex flex-col md:px-10 px-0">
                {{ menuList(true) }}
            </div>

            <div class="relative inline-block bg-white md:px-10 px-6 w-full pb-5 pt-7">
                <div class="gap-[10px] flex justify-center items-center sm:flex-nowrap">
                    <a href="/live-account" class="live-btn-mob">Gerçek Hesap Aç</a>
                    <a href="/forex-demo-account" class="demo-btn-mob">Demo Dene</a>
                </div>
            </div>
        </div>
    </nav>
</header>
