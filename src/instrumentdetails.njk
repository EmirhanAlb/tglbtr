---
layout: layouts/base.njk
pagination:
  data: instrumentDetails
  size: 1
  alias: inst
permalink: /instrumentdetails/{{ inst.slug }}/
eleventyComputed:
  title: "{{ inst.symbol }} İşlem Bilgileri | Trust Capital"
  description: "{{ inst.symbol }} enstrümanı canlı fiyat, spread ve işlem koşulları."
showTicker: false
styles:
  - app-7ecb6376.css
  - style-9adf4d36.css
  - symbol-d300c5e6.css
  - intlTelInput-a2abb0f9.css
  - flag-icons-0a93ade9.css
  - select2-92b09fb4.css
  - app-d45640c1.css
scripts:
  - app-31051ced.js
---
<section class="py-16 md:py-24 bg-[#003E3C]">
    <div class="container mx-auto px-6 text-center">
        <h1 class="text-4xl md:text-6xl font-bold text-[#FAF7F2] mb-6">{{ inst.symbol }}</h1>
        <p class="text-[#A9C2BE] text-lg">{{ inst.symbol }} enstrümanına ait güncel fiyat ve işlem bilgileri.</p>
    </div>
</section>
<section class="py-12 md:py-20">
    <div class="container mx-auto px-6 max-w-3xl">
        <div class="grid md:grid-cols-3 gap-6 text-center">
            <div class="border rounded-2xl p-6">
                <div class="text-sm text-gray-500">Fiyat</div>
                <div class="text-2xl font-bold text-[#003E3C]">{{ inst.bid }}</div>
            </div>
            <div class="border rounded-2xl p-6">
                <div class="text-sm text-gray-500">Günlük Değişim</div>
                <div class="text-2xl font-bold {{ inst.color }}">{{ inst.change }}</div>
            </div>
            <div class="border rounded-2xl p-6">
                <div class="text-sm text-gray-500">Günlük Değişim %</div>
                <div class="text-2xl font-bold {{ inst.color }}">{{ inst.pct }}</div>
            </div>
        </div>
        <div class="mt-10 text-center">
            <a href="/live-account" class="inline-block px-8 py-3 rounded-full bg-[#003E3C] text-white font-semibold">Bu Enstrümanda İşlem Yap</a>
        </div>
    </div>
</section>
