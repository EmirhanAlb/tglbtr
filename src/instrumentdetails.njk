---
layout: layouts/base.njk
pagination:
  data: instrumentDetails
  size: 1
  alias: inst
permalink: /instrumentdetails/{{ inst.slug }}/
eleventyComputed:
  title: "{{ inst.symbol }} İşlem Bilgileri | Trust Capital"
  description: "{{ inst.symbol }} enstrümanı canlı fiyat, spread ve işlem koşulları."
showTicker: false
styles:
  - app-7ecb6376.css
  - style-9adf4d36.css
  - symbol-d300c5e6.css
  - intlTelInput-a2abb0f9.css
  - flag-icons-0a93ade9.css
  - select2-92b09fb4.css
  - app-d45640c1.css
scripts:
  - app-31051ced.js
---
<section class="py-16 md:py-24 bg-[#003E3C]">
    <div class="container mx-auto px-6 text-center">
        <h1 class="text-4xl md:text-6xl font-bold text-[#FAF7F2] mb-6">{{ inst.symbol }}</h1>
        <p class="text-[#A9C2BE] text-lg">{{ inst.symbol }} enstrümanına ait güncel fiyat ve işlem bilgileri.</p>
    </div>
</section>
<section class="py-12 md:py-20">
    <div class="container mx-auto px-6 max-w-3xl">
        {#- Değerler live-prices.js tarafından canlı güncellenir (.SEMBOL_bid vb. sınıflar). #}
        <div class="lp-stats">
            <div class="lp-card">
                <div class="lp-label">Alış</div>
                <div class="lp-value {{ inst.symbol }}_bid">{{ inst.bid }}</div>
            </div>
            <div class="lp-card">
                <div class="lp-label">Satış</div>
                <div class="lp-value {{ inst.symbol }}_ask">{{ inst.ask or inst.bid }}</div>
            </div>
            <div class="lp-card">
                <div class="lp-label">Günlük Değişim</div>
                <div class="lp-value {{ 'lp-down' if inst.color == 'text-red-600' else 'lp-up' }} {{ inst.symbol }}_change">{{ inst.change }}</div>
            </div>
            <div class="lp-card">
                <div class="lp-label">Günlük Değişim %</div>
                <div class="lp-value {{ 'lp-down' if inst.color == 'text-red-600' else 'lp-up' }} {{ inst.symbol }}_change_percentage">{{ inst.pct }}</div>
            </div>
        </div>
        <p class="mt-4 text-center text-sm text-gray-500">Fiyatlar 10 saniyede bir güncellenir.</p>
        <div class="mt-10 text-center">
            <a href="/live-account" class="inline-block px-8 py-3 rounded-full bg-[#003E3C] text-white font-semibold">Bu Enstrümanda İşlem Yap</a>
        </div>
    </div>
</section>
