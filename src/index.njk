                                        src="{{ row.trendImg }}" alt="" width="2.0" height="1.1">
                                </div>
                            </td>
                            {#- Bu sütun gizlidir; sekme filtrelemesi için JS bu İngilizce kimlikleri kullanır. #}
                            <td><span class="{{ row.typeColor }}">{{ row.type }}</span></td>
                        </tr>
                        {%- endfor %}
